material {
    name : SphereMaterial,
    shadingModel : lit,
    flipUV : false,
    parameters : [
        { type : float4, name : baseColor },
        { type : float, name : roughness },
        { type : float, name : metallic },
        { type : sampler2d, name : baseColorTexture },
        { type : sampler2d, name : normalTexture },
        { type : float, name : moonTextureBlend },
        { type : float3, name : lightDirectionToSource },
        { type : float4[10], name : ripples },
        { type : float, name : rippleClock }
    ],
    requires : [
        position,
        tangents,
        uv0
    ]
}

fragment {
    void material(inout MaterialInputs material) {
        float2 uv = getUV0();
        float3 lunarBaseColor = texture(materialParams_baseColorTexture, uv).rgb;
        float3 tangentNormal = texture(materialParams_normalTexture, uv).xyz * 2.0 - 1.0;
        float moonBlend = materialParams.moonTextureBlend;
        material.baseColor = vec4(mix(
            materialParams.baseColor.rgb,
            lunarBaseColor,
            moonBlend
        ), 1.0);
        float3 shadingNormal = normalize(mix(
            vec3(0.0, 0.0, 1.0),
            tangentNormal,
            moonBlend
        ));
        material.roughness = mix(materialParams.roughness, 0.72, moonBlend);
        material.metallic = mix(materialParams.metallic, 0.0, moonBlend);

        float3 surfaceDirection = normalize(getUserWorldPosition());
        float combinedWave = 0.0;
        for (int slot = 0; slot < 10; slot++) {
            float4 rippleData = materialParams.ripples[slot];
            float rippleTime = materialParams.rippleClock - rippleData.w;
            if (rippleData.w >= 0.0 && rippleTime >= 0.0 && rippleTime < 3.0) {
                float angularDistance = acos(clamp(
                    dot(surfaceDirection, rippleData.xyz),
                    -1.0,
                    1.0
                ));
                float frontDistance = 1.12 * rippleTime;
                float x = (angularDistance - frontDistance) / 0.085;
                float envelope = exp(-0.5 * x * x);
                float signedWave = (1.0 - x * x) * envelope;
                float timeDamping = exp(-0.55 * rippleTime) *
                    (1.0 - smoothstep(2.55, 2.90, rippleTime));
                combinedWave += signedWave * timeDamping;
            }
        }

        float displayWave = tanh(combinedWave);
        float crest = max(displayWave, 0.0);
        float trough = max(-displayWave, 0.0);
        material.baseColor.rgb = mix(
            material.baseColor.rgb,
            vec3(0.05, 0.85, 1.0),
            min(1.0, crest * 1.4)
        );
        material.baseColor.rgb = mix(
            material.baseColor.rgb,
            vec3(0.04, 0.03, 0.20),
            min(1.0, trough * 0.9)
        );
        material.roughness = clamp(
            material.roughness - crest * 0.18 + trough * 0.14,
            0.08,
            1.0
        );
        material.emissive = vec4(vec3(0.0, 1.6, 4.0) * crest, 1.0);

        const float TERMINATOR_FADE_WIDTH = 0.15;
        float3 geometricNormal = getWorldGeometricNormalVector();
        float geometricNoL = dot(
            geometricNormal,
            materialParams.lightDirectionToSource
        );
        float normalWeight = smoothstep(
            0.0,
            TERMINATOR_FADE_WIDTH,
            geometricNoL
        );
        material.normal = normalize(mix(
            vec3(0.0, 0.0, 1.0),
            shadingNormal,
            normalWeight
        ));
        prepareMaterial(material);
    }
}
